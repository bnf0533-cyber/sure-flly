# PostgreSQL / Supabase: copy its connection string; never expose it to Vite.
DB_MODE=postgres
DB_URL=postgresql://postgres:replace-me@localhost:5432/sureflight
DB_SSL=false
JWT_SECRET=replace-with-at-least-32-cryptographically-random-characters
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
FLIGHT_PROVIDER=mock
TRACKER_ENABLED=true
DEMO_SEED=false
NODE_ENV=development
