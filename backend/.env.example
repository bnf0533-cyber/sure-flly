# Development only. Copy to .env; never commit secrets.
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
DB_URL=postgresql://user:password@host:5432/database
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
# PEM text if your database provider uses a private CA
DB_CA_CERT=
JWT_SECRET=
FLIGHT_PROVIDER=aviationstack
AVIATIONSTACK_API_KEY=
TRACKER_ENABLED=true
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_TEST_TO=
PDF_FONT_PATH=C:/Windows/Fonts/arial.ttf
TRUST_PROXY=0
